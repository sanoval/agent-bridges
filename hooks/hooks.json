{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-bridges-gate.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__antigravity__agy_run(_sync)?",
        "hooks": [
          {
            "type": "command",
            "command": "agy-mcp hook-wait",
            "asyncRewake": true,
            "timeout": 3700
          }
        ]
      }
    ]
  }
}
